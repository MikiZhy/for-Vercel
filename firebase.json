{
  "hosting": {
    "public": "for vercel only",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ],
    "redirects": [
      {
        "source": "/fofa/:path*",
        "destination": "https://caxl1.pages.dev/fofa/:path",
        "type": 302
      }
    ]
  }
}
